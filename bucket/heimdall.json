{
    "version": "1.0.1",
    "description": "A fast, lightweight, glassy launcher and file searcher for Windows",
    "homepage": "https://github.com/Kryzern/Heimdall",
    "license": "MIT",
    "notes": [
        "Start Heimdall from the Start menu, then press Alt+Space.",
        "Type 'settings' in Heimdall to turn on Start with Windows or change the hotkey.",
        "For faster file search, type 'install indexer' in Heimdall (needs admin once)."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Kryzern/Heimdall/releases/download/v1.0.1/Heimdall-1.0.1-x64.zip",
            "hash": "78fa17bae8918b0651c18f0d9b98e68e5da636511b26fa77f486c253fe679fb7"
        }
    },
    "shortcuts": [
        [
            "heimdall.exe",
            "Heimdall"
        ]
    ],
    "uninstaller": {
        "script": [
            "$run = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
            "$value = (Get-ItemProperty -Path $run -Name 'Heimdall' -ErrorAction SilentlyContinue).Heimdall",
            "if ($cmd -eq 'uninstall' -and $value -like '*\\apps\\heimdall\\*') {",
            "    Remove-ItemProperty -Path $run -Name 'Heimdall'",
            "}"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Kryzern/Heimdall/releases/download/v$version/Heimdall-$version-x64.zip"
            }
        }
    }
}
